# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Сами графы обучаются в Colab и лежат в релизах — в репозиторий не кладём.
# Описания моделей маленькие и полезны сами по себе: по ним видно список
# видов и точность, не скачивая 90 МБ.
model/*
!model/.gitkeep
!model/*.labels.json

# Фронтенд
node_modules/
frontend/dist/

# IDE: настройки PyCharm локальные и содержат пути рабочей машины
.idea/

# Артефакты сборки пакета
*.egg-info/
